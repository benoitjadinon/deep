{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.byjw.deep",
  "Name": "Deep",
  "Version": "0.1.0.0",
  "Author": "BYJW Studio",
  "Description": "Control Orca agent sessions on an 8-slot status board. Color=State, Tap=Focus.",
  "Category": "Deep",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/launch.sh",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.0"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Actions": [
    {
      "Name": "Session Slot",
      "UUID": "com.byjw.deep.slot",
      "Icon": "imgs/actions/slot/icon",
      "Tooltip": "Display session state · Tap to focus corresponding Orca terminal",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ]
    },
    {
      "Name": "Model",
      "UUID": "com.byjw.deep.model",
      "Icon": "imgs/actions/model/icon",
      "Tooltip": "Rotate to select model, push to apply (/model in target session)",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/slot/icon",
        "layout": "layouts/dial.json"
      }
    },
    {
      "Name": "Effort",
      "UUID": "com.byjw.deep.effort",
      "Icon": "imgs/actions/effort/icon",
      "Tooltip": "Rotate to select effort, push to apply (/effort in target session)",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/slot/icon",
        "layout": "layouts/dial.json"
      }
    },
    {
      "Name": "Mode",
      "UUID": "com.byjw.deep.mode",
      "Icon": "imgs/actions/model/icon",
      "Tooltip": "Rotate to select mode/agent, push to apply (plan, build, etc.)",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/slot/icon",
        "layout": "layouts/dial.json"
      }
    },
    {
      "Name": "Talk",
      "UUID": "com.byjw.deep.talk",
      "Icon": "imgs/actions/talk/icon",
      "Tooltip": "Push to talk (Speech-to-Text)",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/slot/icon",
        "layout": "layouts/dial.json"
      }
    },
    {
      "Name": "Target Session",
      "UUID": "com.byjw.deep.target",
      "Icon": "imgs/actions/target/icon",
      "Tooltip": "Rotate to walk sessions, push to jump to that session",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/slot/key"
        }
      ],
      "Encoder": {
        "Icon": "imgs/actions/slot/icon",
        "layout": "layouts/dial.json"
      }
    }
  ]
}