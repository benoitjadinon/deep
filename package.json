{
  "name": "agentdeck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Stream Deck Plus로 Orca에서 도는 Claude Code 에이전트 세션을 상태판으로 지휘",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "poll": "node scripts/poll.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build": "esbuild src/plugin.ts --bundle --platform=node --target=node20 --format=cjs --outfile=com.byjw.deep.sdPlugin/bin/plugin.js --log-level=warning",
    "package": "npm run icons && npm run build"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  }
}
